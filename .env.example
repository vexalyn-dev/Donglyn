# Google OAuth 2.0 Client ID and Secret
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-key
GOOGLE_CLIENT_SECRET=your-google-client-secret1-key

# Fonnte WhatsApp API
# Get from: https://md.fonnte.com/new/register.php (Free 1000 msg/month)
FONNTE_TOKEN=your-fonte-token

# Resend Email API
# Get from: https://resend.com/api-keys (100 emails/day free)
RESEND_API_KEY=your-api-key-resend

# Supabase
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Secret key for Flask sessions
SECRET_KEY=vexora-secret-key-2026-vexalyn
